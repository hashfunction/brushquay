# Windows batch files must be in CRLF to not make cmd.exe freak out
*.cmd text eol=crlf
*.bat text eol=crlf

# Make sure Windows .lnk shortcuts are binary
*.lnk binary

# Patch files must be checked out in CRLF on Windows for patch to work
*.patch text=auto
*.diff text=auto

# Original third-party notices preserve publisher bytes on every checkout.
/distribution/native-source/original-notices/** -text
# Original readback receipts and exact release-review inputs retain their bytes.
/packaging/windows/msix/release-data/** -text
